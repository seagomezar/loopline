    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly uses the camera to record each part of your video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly usa la cámara para grabar cada parte de tu video."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly uses the microphone to record your voice or instrument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly usa el micrófono para grabar tu voz o tu instrumento."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly saves finished performances to your Photos library when you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdubly guarda tus videos terminados en Fotos cuando tú lo eliges."
